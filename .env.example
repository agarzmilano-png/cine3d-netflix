# Cine3D Netflix - ortam değişkenleri örneği
# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env dosyası .gitignore içindedir.

# OMDb API anahtarları (virgülle ayrılmış rotasyon listesi).
# http://www.omdbapi.com/apikey.aspx adresinden ücretsiz anahtar alın.
# Tanımlanmazsa yalnızca herkese açık "trilogy" demo anahtarı kullanılır (günlük kota çok düşük).
OMDB_API_KEYS=

# Sunucu
PORT=3300
# Tünel için 127.0.0.1 yeterlidir. LAN cihazlarından erişmek isterseniz 0.0.0.0 yapın.
HOST=127.0.0.1

# Dış servis zaman aşımları (ms)
OUTBOUND_TIMEOUT_MS=8000
STREAM_TIMEOUT_MS=20000