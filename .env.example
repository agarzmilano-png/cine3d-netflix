# Cine3D Netflix - ortam değişkenleri örneği
# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env dosyası .gitignore içindedir.

# OMDb API anahtarları (virgülle ayrılmış rotasyon listesi).
# http://www.omdbapi.com/apikey.aspx adresinden ücretsiz anahtar alın.
# Tanımlanmazsa yalnızca herkese açık "trilogy" demo anahtarı kullanılır (günlük kota çok düşük).
OMDB_API_KEYS=

# Sunucu
PORT=3300
# Tünel için 127.0.0.1 yeterlidir. LAN cihazlarından erişmek isterseniz 0.0.0.0 yapın.
HOST=127.0.0.1

# Dış servis zaman aşımları (ms)
OUTBOUND_TIMEOUT_MS=8000
STREAM_TIMEOUT_MS=20000

# API kötüye kullanım koruması (sunucu modu)
# Virgülle ayrılmış izinli origin listesi. Boşsa yalnızca GitHub Pages adresi +
# localhost serbesttir. Tüm originlere açmak için * yazın (önerilmez).
ALLOWED_ORIGINS=https://agarzmilano-png.github.io
# IP başına dakikalık JSON API isteği sınırı (0 = kapalı).
# Ses akışı (/api/stream-ost) ve sağlık kontrolü bu sınıra dahil değildir.
API_RATE_LIMIT=60

# Ses akışı ayrı kota ve eşzamanlılık (JSON API'den bağımsız)
STREAM_RATE_LIMIT=240
STREAM_MAX_CONCURRENT=8